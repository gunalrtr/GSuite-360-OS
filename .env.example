# Database Configuration
# Replace with your Supabase or local PostgreSQL URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gsuite360?schema=public"

# NestJS Backend API Configuration
PORT=4000
JWT_SECRET="super-secret-jwt-key-gsuite-360-xyz"
FRONTEND_URL="http://localhost:3000"

# NextAuth / Google OAuth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="gsuite360-nextauth-secret-key-123456"
NEXTAUTH_URL="http://localhost:3000"

# Register credentials in Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
